ClearAll["Global'*"];
list[y_] := y[[1]] == y[[2]];
rplc[y_] := y;
(*We define the function that implements the signature change*)
\[Epsilon][r_] := \[Epsilon]Func[r];

(* Non-vanishing components of the LQE Kerr metric g_{\[Mu]\[Nu]} in Doran coordinates {t, r, \[Theta], \[CurlyPhi]} *)
g11 = gtt = -\[Epsilon][r] (1 - (2 M r)/(r^2 + a^2 Cos[\[Theta]]^2));
g22 = grr = (r^2 + a^2 Cos[\[Theta]]^2)/(r^2 + a^2);   
g33 = g\[Theta]\[Theta] = r^2 + a^2 Cos[\[Theta]]^2;
g44 = g\[CurlyPhi]\[CurlyPhi] = (r^2 + a^2 + (
      2 M r a^2 Sin[\[Theta]]^2)/(
      r^2 + a^2 Cos[\[Theta]]^2)) Sin[\[Theta]]^2;
g14 = gt\[CurlyPhi] = -Sqrt[\[Epsilon][r]] (2 M r a Sin[\[Theta]]^2)/(
    r^2 + a^2 Cos[\[Theta]]^2) ;
g12 = gtr = Sqrt[\[Epsilon][r]] Sqrt[(2 M r)/(r^2 + a^2)];
g24 = gr\[CurlyPhi] = -Sqrt[((2 M r)/(r^2 + a^2))] a Sin[\[Theta]]^2;
g23 = g34 = g13 = 0;

(* Coordinate basis and spacetime dimension *)
x = {t, r, \[Theta], \[CurlyPhi]}; n = 4;

(* Construction of the covariant metric tensor g_{\[Mu]\[Nu]} *)
mt = FullSimplify[{
    {g11, g12, g13, g14},
    {g12, g22, g23, g24},
    {g13, g23, g33, g34},
    {g14, g24, g34, g44}
    }];

(* Contravariant metric tensor g^{\[Mu]\[Nu]} *)
it = FullSimplify[Inverse[mt]];

(* Verification of the identity g^{\[Mu]\[Alpha]} g_{\[Alpha]\[Nu]} = \[Delta]^{\[Mu]}_{\[Nu]} *)
mx = FullSimplify[Table[Simplify[Sum[it[[i, k]]*mt[[k, j]], {k, 1, n}]], {i, 1, n}, {j, 1, n}]];

(* Determinant of the covariant metric tensor g_{\[Mu]\[Nu]} *)
md = FullSimplify[Det[mt]];

(* Christoffel symbols \[CapitalGamma]^{\[Gamma]}_{\[Mu]\[Nu]} *)
chr = ParallelTable[FullSimplify[(1/2) Sum[(it[[i, s]]) (D[mt[[s, j]], x[[k]]] + D[mt[[s, k]], x[[j]]] - D[mt[[j, k]], x[[s]]]), {s, 1, n}]], {i, 1, n}, {j, 1, n}, {k, 1, n}];

(*Riemann curvature tensor R^{\[Delta]}_{\[Mu]\[Nu]\[Gamma]}*)
rmn = ParallelTable[FullSimplify[D[chr[[i, j, l]], x[[k]]] - D[chr[[i, j, k]], x[[l]]] + Sum[chr[[s, j, l]]*chr[[i, k, s]] - chr[[s, j, k]]*chr[[i, l, s]], {s, 1, n}]], {i, 1, n}, {j, 1, n}, {k, 1, n}, {l, 1, n}];

(* Ricci tensor R_{\[Mu]\[Nu]} obtained by contracting the Riemann tensor *)
rcc = ParallelTable[FullSimplify[Sum[rmn[[i, j, i, l]], {i, 1, n}]], {j, 1, n}, {l, 1, n}];

(* Ricci scalar R obtained by contracting g^{\[Mu]\[Nu]} with R_{\[Mu]\[Nu]} *)
R = FullSimplify[Sum[it[[i, j]] rcc[[i, j]], {i, 1, n}, {j, 1, n}]];

(* Computation of the fully covariant Riemann tensor R_{\[Mu]\[Nu]\[Alpha]\[Beta]} by lowering the first index *)
rcv = ParallelTable[FullSimplify[Sum[mt[[i, j]]*rmn[[j, k, l, m]], {j, 1, n}]], {i, 1, n}, {k, 1, n}, {l, 1, n}, {m, 1, n}];

(* Fully contravariant Riemann tensor R^{\[Mu]\[Nu]\[Alpha]\[Beta]} *)
rcn = ParallelTable[FullSimplify[Sum[it[[m, i]]*it[[h, j]]*it[[o, k]]*it[[p, l]]*rcv[[i, j, k, l]], {i, 1, n}, {j, 1, n}, {k, 1, n}, {l, 1, n}]], {m, 1, n}, {h, 1, n}, {o, 1, n}, {p, 1, n}];

(* Kretschmann scalar K = R_{\[Mu]\[Nu]\[Alpha]\[Beta]} R^{\[Mu]\[Nu]\[Alpha]\[Beta]} *)
krn = FullSimplify[Sum[rcv[[i, j, k, l]]*rcn[[i, j, k, l]], {i, 1, n}, {j, 1, n}, {k, 1, n}, {l, 1, n}]];
