Cell[BoxData[{
 RowBox[{
  RowBox[{"rplus", "=", 
   RowBox[{"M", "+", 
    SqrtBox[
     RowBox[{
      RowBox[{"M", "^", "2"}], " ", "-", " ", 
      RowBox[{"a", "^", "2"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", "[", 
    RowBox[{"r_", "[", "\[Tau]_", "]"}], "]"}], ":=", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "[", "\[Tau]", "]"}], "-", "rplus"}], ")"}], 
     FractionBox["1", 
      RowBox[{
       RowBox[{"2", " ", "\[Lambda]"}], "+", "1"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "[", "\[Tau]", "]"}], "-", "rplus"}], ")"}], "2"], "+",
        "\[Beta]"}], ")"}], 
     FractionBox["1", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "\[Lambda]"}], "+", "1"}], ")"}]}]]]]}], 
  ";"}]}], "Input",
 CellChangeTimes->{
  3.9857552607101192`*^9, {3.9857553175707693`*^9, 3.985755386482708*^9}, {
   3.985755723609768*^9, 3.985755758959045*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"5d63626f-0d1e-4b39-b1cc-efaa5e23aa5a"],

