  3.98532307051017*^9}},ExpressionUUID->"54abdd63-9bec-47bb-8763-\
4dc7fa2dd464"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wcv", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"rcv", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"n", "-", "2"}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
           RowBox[{"rcc", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
           RowBox[{"rcc", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "k"}], "]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "k"}], "]"}], "]"}], 
           RowBox[{"rcc", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "l"}], "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "l"}], "]"}], "]"}], " ", 
           RowBox[{"rcc", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["R", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"n", "-", "2"}], ")"}]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
           RowBox[{"mt", "[", 
            RowBox[{"[", 
             RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.98532307248715*^9, 3.985323220857339*^9}, {
  3.985323255641242*^9, 3.9853232807284203`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"caa761e3-edaa-4949-92ba-0a8c50bfe303"],

Cell[TextData[{
 "Fully contravariant Weyl Tensor ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", "\[Mu]\[Nu]\[Alpha]\[Beta]"], TraditionalForm]],
  ExpressionUUID->"108752af-d031-4c92-b26f-c0eb1041aa97"]
}], "Text",
 CellChangeTimes->{{3.9853235214780817`*^9, 
  3.985323557281885*^9}},ExpressionUUID->"a887e2b7-f709-4d1b-acda-\
d960a7f26fe8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"wcn", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"it", "[", 
          RowBox[{"[", 
           RowBox[{"m", ",", "i"}], "]"}], "]"}], "*", 
         RowBox[{"it", "[", 
          RowBox[{"[", 
           RowBox[{"h", ",", "j"}], "]"}], "]"}], "*", 
         RowBox[{"it", "[", 
          RowBox[{"[", 
           RowBox[{"o", ",", "k"}], "]"}], "]"}], "*", 
         RowBox[{"it", "[", 
          RowBox[{"[", 
           RowBox[{"p", ",", "l"}], "]"}], "]"}], "*", 
         RowBox[{"wcv", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"o", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"p", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985323560950725*^9, 3.985323579226692*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"7bba8f3b-3163-4548-a664-6dc2e6e651cf"],

Cell[TextData[{
 "Weyl tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["C", "\[Mu]"], "\[Nu]\[Alpha]\[Beta]"], TraditionalForm]],
  ExpressionUUID->"6c8c3688-9bfb-47bc-8e60-dd1da61a368e"]
}], "Text",
 CellChangeTimes->{{3.9853233812241507`*^9, 3.9853234174368553`*^9}, {
  3.985323519625855*^9, 
  3.985323519865828*^9}},ExpressionUUID->"35528e50-cec0-4219-bedd-\
5e3e8a776cd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"weyl", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"it", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "s"}], "]"}], "]"}], 
         RowBox[{"wcv", "[", 
          RowBox[{"[", 
           RowBox[{"s", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.985323418744399*^9, 3.9853234735805798`*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"bc9afbad-ca00-4b4d-b2dc-f5528e176211"],

Cell["Weyl tensor norm C", "Text",
 CellChangeTimes->{{3.9853235007744513`*^9, 3.9853235011705303`*^9}, {
  3.9853235861452703`*^9, 
  3.98532361780989*^9}},ExpressionUUID->"2c17da97-c460-42c1-b207-\
70b6c241cd8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"cnorm", " ", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"wcv", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}], "*", 
       RowBox[{"wcn", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.985323618601508*^9, 3.9853236434802847`*^9}, {
  3.9853237124181004`*^9, 3.985323714934786*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"b2e4d2ab-194f-4373-8269-915512204884"],

Cell["\<\
Final verification that Weyl tensor norm should be equal to Kretschmann scalar\
\>", "Text",
 CellChangeTimes->{{3.985323786924602*^9, 
  3.985323802246428*^9}},ExpressionUUID->"11d780a9-2633-47de-86e6-\
cce09aa6bdb3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"cnorm", "-", "krn"}], ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"\[Epsilon]", "[", "r", "]"}], ",", "r"}], "]"}], "->", "0"}],
      ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Epsilon]", "[", "r", "]"}], ",", "r"}], "]"}], ",", 
        "r"}], "]"}], "->", "0"}]}], "}"}]}], "//", "FullSimplify"}]], "Input",\

