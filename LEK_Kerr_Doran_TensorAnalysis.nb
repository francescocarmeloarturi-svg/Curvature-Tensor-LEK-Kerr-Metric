Cell[BoxData[{
 RowBox[{
  RowBox[{"geo", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"chr", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], 
         RowBox[{"uu", "[", 
          RowBox[{"[", "j", "]"}], "]"}], " ", 
         RowBox[{"uu", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"equ", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"uu", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\[Tau]"}], "]"}], "==", 
       RowBox[{"rplc", "[", 
        RowBox[{"geo", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"geodesic1", "=", 
   RowBox[{
    RowBox[{"equ", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"geodesic2", "=", 
   RowBox[{
    RowBox[{"equ", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"geodesic3", "=", 
   RowBox[{
    RowBox[{"equ", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"geodesic4", "=", 
   RowBox[{
    RowBox[{"equ", "[", 
     RowBox[{"[", "4", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.9857593024499598`*^9},
 CellLabel->"In[63]:=",ExpressionUUID->"86923972-80bb-4275-ac55-d47787380022"],

Cell["\<\
We set the parameters for the black hole and the LEK smooth function\
\>", "Text",
 CellChangeTimes->{{3.985757591402761*^9, 3.985757593149458*^9}, {
  3.98575961158342*^9, 
  3.9857596331739197`*^9}},ExpressionUUID->"36608424-37f4-4361-a010-\
3e2c740642d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "0.99"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"M", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "=", "1"}], ";"}], "          "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "=", "0.001"}], ";"}], "    "}]}], "Input",
 CellChangeTimes->{{3.9857576058886213`*^9, 3.985757642287067*^9}, {
  3.985757804009671*^9, 3.985757804288258*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"b3a2bb4e-5f84-4659-9d78-3c11a3471243"],

Cell["\<\
Finally, we numerically integrate the geodesic equations. The following is \
configuration A from Table I in the Paper, but other cases can be obtained \
replacing the initial condition values\
\>", "Text",
 CellChangeTimes->{{3.985757809204095*^9, 3.9857578129852343`*^9}, {
  3.9857584408586073`*^9, 3.985758452094887*^9}, {3.985759408339345*^9, 
  3.985759486472891*^9}, {3.985759604735273*^9, 3.985759605789887*^9}, {
  3.985760389404229*^9, 
  3.985760404863744*^9}},ExpressionUUID->"7e745410-e2a5-45fd-9688-\
df05b6910352"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   SubscriptBox["\[Tau]", "f"], "=", "2000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ni", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "eqs1", ",", "eqs2", ",", "eqs3", ",", "eqs4", ",", "geodesic1", ",", 
       "geodesic2", ",", " ", "geodesic3", ",", "geodesic4", ",", " ", 
       RowBox[{
        RowBox[{"t", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"r", "[", "0", "]"}], "==", "2.2"}], ",", 
       RowBox[{
        RowBox[{"\[Theta]", "[", "0", "]"}], "==", 
        RowBox[{"\[Pi]", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{"\[CurlyPhi]", "[", "0", "]"}], "==", "\[Pi]"}], ",", 
       RowBox[{
        RowBox[{"ut", "[", "0", "]"}], "==", "12.245"}], ",", 
       RowBox[{
        RowBox[{"ur", "[", "0", "]"}], "==", 
        RowBox[{"-", "0.001"}]}], ",", 
       RowBox[{
        RowBox[{"u\[Theta]", "[", "0", "]"}], "==", "2"}], ",", 
       RowBox[{
        RowBox[{"u\[CurlyPhi]", "[", "0", "]"}], "==", "3"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
      "t", ",", "r", ",", "\[Theta]", ",", "\[CurlyPhi]", ",", "ut", ",", 
       "ur", ",", "u\[Theta]", ",", "u\[CurlyPhi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", 
       SubscriptBox["\[Tau]", "f"]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9857578403853416`*^9, 3.985757863646625*^9}, {
  3.985757896232027*^9, 3.985757899390029*^9}, {3.985758014914237*^9, 
  3.985758044850972*^9}, {3.985760260385715*^9, 
  3.9857602767628727`*^9}},ExpressionUUID->"94be512a-0a2e-4799-b6bc-\
55442312d72f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[CurlyPhi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "[", "\[Tau]", "]"}], "^", "2"}], "+", 
            RowBox[{"a", "^", "2"}]}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[CurlyPhi]", "[", "\[Tau]", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"r", "[", "\[Tau]", "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Theta]", "[", "\[Tau]", "]"}], "]"}]}]}], "}"}], "/.", 
       " ", "ni"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Tau]", ",", "0", ",", "100"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "8"}], ",", "8"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Darker", "[", "Magenta", "]"}], ",", "Thick"}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sfera", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Opacity", "[", "0.9", "]"}], ",", "Black", ",", 
       RowBox[{"Sphere", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "rplus"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Boxed", "->", "False"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"traj", ",", "sfera", ",", 
   RowBox[{"Boxed", "->", "False"}], ",", 
   RowBox[{"Axes", "->", "True"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], ",", 
   
   RowBox[{"ViewPoint", "->", "Front"}], ",", 
   RowBox[{"Lighting", "->", "\"\<Neutral\>\""}]}], "]"}]}], "Input",
