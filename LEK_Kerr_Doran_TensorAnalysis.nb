Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"chr", "=", 
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"it", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "s"}], "]"}], "]"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"mt", "[", 
                RowBox[{"[", 
                 RowBox[{"s", ",", "j"}], "]"}], "]"}], ",", 
               RowBox[{"x\[Tau]", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "+", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"mt", "[", 
                RowBox[{"[", 
                 RowBox[{"s", ",", "k"}], "]"}], "]"}], ",", 
               RowBox[{"x\[Tau]", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "-", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"mt", "[", 
                RowBox[{"[", 
                 RowBox[{"j", ",", "k"}], "]"}], "]"}], ",", 
               RowBox[{"x\[Tau]", "[", 
                RowBox[{"[", "s", "]"}], "]"}]}], "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}], ",", 
