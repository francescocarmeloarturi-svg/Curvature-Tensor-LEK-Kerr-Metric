Cell["\<\
We define the four-velocity as first derivatives of the the position with \
respect to the affine parameter \[Tau] \
\>", "Text",
 CellChangeTimes->{{3.985756953332342*^9, 3.985756966729938*^9}, {
  3.985759643333914*^9, 
  3.985759663429924*^9}},ExpressionUUID->"798ed36e-4c47-4226-9a66-\
485cdb258704"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"u", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"x\[Tau]", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "\[Tau]"}], "]"}], ",", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"x\[Tau]", "[", 
        RowBox[{"[", "2", "]"}], "]"}], ",", "\[Tau]"}], "]"}], ",", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"x\[Tau]", "[", 
        RowBox[{"[", "3", "]"}], "]"}], ",", "\[Tau]"}], "]"}], ",", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"x\[Tau]", "[", 
        RowBox[{"[", "4", "]"}], "]"}], ",", "\[Tau]"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uu", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ut", "[", "\[Tau]", "]"}], ",", " ", 
     RowBox[{"ur", "[", "\[Tau]", "]"}], ",", " ", 
     RowBox[{"u\[Theta]", "[", "\[Tau]", "]"}], ",", " ", 
     RowBox[{"u\[CurlyPhi]", "[", "\[Tau]", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs1", "=", 
   RowBox[{
    RowBox[{"uu", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "==", 
    RowBox[{"u", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs2", "=", 
   RowBox[{
    RowBox[{"uu", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "==", 
    RowBox[{"u", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs3", "=", 
   RowBox[{
    RowBox[{"uu", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "==", 
    RowBox[{"u", "[", 
     RowBox[{"[", "3", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs4", "=", 
   RowBox[{
    RowBox[{"uu", "[", 
     RowBox[{"[", "4", "]"}], "]"}], "==", 
    RowBox[{"u", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"079c042e-6621-4638-a764-7499a99fa912"],

Cell[TextData[{
 "We write down the geodesic equation ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["du", "\[Mu]"], "d\[Tau]"], TraditionalForm]],
  ExpressionUUID->"a6cb26ba-e2c4-4f59-9328-433ab5a097dc"],
 " = - ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalGamma]", "\[Nu]\[Gamma]", "\[Mu]"], 
   TraditionalForm]],ExpressionUUID->"3c2fdc5a-77e2-4891-8076-71bf6d3590a6"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "\[Nu]"], TraditionalForm]],ExpressionUUID->
  "3100588b-0854-475a-bb3c-3bf93bdf9115"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "\[Gamma]"], TraditionalForm]],ExpressionUUID->
