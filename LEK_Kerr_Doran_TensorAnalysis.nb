Cell[CellGroupData[{

Cell["The Lorentzian quasi-Euclidean Kerr black hole (LEK)", "Chapter",
 CellChangeTimes->{{3.983271662998891*^9, 3.9832716632491293`*^9}, {
  3.983271754974434*^9, 
  3.98327176383246*^9}},ExpressionUUID->"85c0c7a1-105e-4bdf-a8fb-\
8a68dd9f2f2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global'*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"list", "[", "y_", "]"}], ":=", 
   RowBox[{
    RowBox[{"y", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "==", 
    RowBox[{"y", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rplc", "[", "y_", "]"}], ":=", "y"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9832717654121237`*^9, 3.983271776056299*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"75bc2205-1ce0-482b-a2d0-cf9e4d193a3c"],

Cell[CellGroupData[{

Cell["Metric definition", "Section",
 CellChangeTimes->{{3.983271777914596*^9, 
  3.9832717881495523`*^9}},ExpressionUUID->"13defe65-fe58-4062-9598-\
4ff9e2cba802"],

Cell["\<\
We start by defining the coordinates vector using the Doran coordinate system \
{t, r, \[Theta], \[CurlyPhi]}\
\>", "Text",
 CellChangeTimes->{{3.983271788811285*^9, 
  3.983271799549858*^9}},ExpressionUUID->"b84e446e-546d-45d1-9135-\
b949cd444cbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], ";", 
  RowBox[{"n", "=", "4"}], ";"}]], "Input",
 CellChangeTimes->{{3.983271800059226*^9, 3.983271809583918*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"6835c42d-b0a2-45d8-8912-840b8a1bfb95"],

Cell["and the function that implements the signature change \[Epsilon]", \
"Text",
 CellChangeTimes->{{3.983271885697413*^9, 
  3.9832719012963877`*^9}},ExpressionUUID->"28c94f35-bbe8-4196-9a32-\
099a1a3303fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Epsilon]", "[", "r_", "]"}], ":=", 
   RowBox[{"\[Epsilon]Func", "[", "r", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.983271903128578*^9, 3.983271911898781*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"3353c183-2f00-4585-ae25-8296d876b82d"],

Cell[TextData[{
 "We initialize the non-vanishing components of the LEK metric ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12b9b58e-c841-4f57-8a58-d4cd500e1ba0"],
 " in Doran coordinates"
}], "Text",
 CellChangeTimes->{{3.9832719236965303`*^9, 
  3.983271950128326*^9}},ExpressionUUID->"c15f4811-2d07-48bf-b7ca-\
55472cb2bafa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"g11", "=", 
   RowBox[{"gtt", "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"\[Epsilon]", "[", "r", "]"}]}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "M", " ", "r"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"a", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}]}]}], 
      ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g22", "=", 
   RowBox[{"grr", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{
        RowBox[{"a", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{"a", "^", "2"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g33", "=", 
   RowBox[{"g\[Theta]\[Theta]", "=", 
    RowBox[{
     RowBox[{"r", "^", "2"}], "+", 
     RowBox[{
      RowBox[{"a", "^", "2"}], " ", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g44", "=", 
   RowBox[{"g\[CurlyPhi]\[CurlyPhi]", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"r", "^", "2"}], "+", 
       RowBox[{"a", "^", "2"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "M", " ", "r", " ", 
          RowBox[{"a", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "+", 
          RowBox[{
           RowBox[{"a", "^", "2"}], " ", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}]}]}], 
      ")"}], " ", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g14", "=", 
   RowBox[{"gt\[CurlyPhi]", "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Epsilon]", "[", "r", "]"}], "]"}]}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"2", " ", "M", " ", "r", " ", "a", " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "+", 
        RowBox[{
         RowBox[{"a", "^", "2"}], " ", 
         RowBox[{
          RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}], 
       ")"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g12", "=", 
   RowBox[{"gtr", "=", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Epsilon]", "[", "r", "]"}], "]"}], " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", " ", "M", " ", "r"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "^", "2"}], "+", 
         RowBox[{"a", "^", "2"}]}], ")"}]}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g24", "=", 
   RowBox[{"gr\[CurlyPhi]", "=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", " ", "M", " ", "r"}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r", "^", "2"}], "+", 
           RowBox[{"a", "^", "2"}]}], ")"}]}], ")"}], "]"}]}], " ", "a", " ", 
     
     RowBox[{
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"g23", "=", 
   RowBox[{"g34", "=", 
    RowBox[{"g13", "=", "0"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.983271934927065*^9, 3.983271964686865*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"02601684-bdb2-4fff-a556-f04843966592"],

Cell[TextData[{
 "We now construct the metric tensor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "0f93e8cb-60ef-403f-8697-3ef4f4474cde"],
 " and compute the inverse metric ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "58b683b3-a9c0-4949-8283-fa7ec6cb5a43"],
 ". \nWe also compute the determinant of the metric and verify the identity \
relation  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "bafbd785-6ced-472e-b2ad-7bbece0b3849"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["g", "\[Mu]\[Nu]"], TraditionalForm]],ExpressionUUID->
  "ccd1a69e-81fc-49af-aa4c-9d23f47786db"]
}], "Text",
 CellChangeTimes->{{3.983272013916975*^9, 
  3.9832720847999067`*^9}},ExpressionUUID->"6407cc14-f33b-49da-b77f-\
bc0b46f5411f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mt", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g11", ",", "g12", ",", "g13", ",", "g14"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g12", ",", "g22", ",", "g23", ",", "g24"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g13", ",", "g23", ",", "g33", ",", "g34"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"g14", ",", "g24", ",", "g34", ",", "g44"}], "}"}]}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"it", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Inverse", "[", "mt", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mx", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"it", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
          RowBox[{"mt", "[", 
           RowBox[{"[", 
            RowBox[{"k", ",", "j"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"md", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", "mt", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "mt", "]"}], "\n", 
 RowBox[{"MatrixForm", "[", "it", "]"}], "\n", 
 RowBox[{"MatrixForm", "[", "mx", "]"}]}], "Input",
 CellChangeTimes->{{3.983272086659655*^9, 3.983272103392446*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"9e057304-b076-42f6-a124-85b4ab73be9a"],

