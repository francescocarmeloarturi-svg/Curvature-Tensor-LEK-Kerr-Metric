Cell[BoxData[
 RowBox[{
  RowBox[{"chr", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}], " ", 
       RowBox[{"Sum", "[", 
